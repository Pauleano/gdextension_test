# Godot auto generated files
*.gen.*
.godot/

# Ignore library files but not the gdextension file
project/bin/*
!project/bin/android
project/bin/android/*
!project/bin/android/.gitkeep
!project/bin/linux
project/bin/linux/*
!project/bin/linux/.gitkeep
!project/bin/macos
project/bin/macos/*
!project/bin/macos/.gitkeep
!project/bin/windows
project/bin/windows/*
!project/bin/windows/.gitkeep
!project/bin/*.gdextension

# CMake's root bin/ build output (keep the empty platform dirs via .gitkeep)
bin/*
!bin/android
bin/android/*
!bin/android/.gitkeep
!bin/linux
bin/linux/*
!bin/linux/.gitkeep
!bin/macos
bin/macos/*
!bin/macos/.gitkeep
!bin/windows
bin/windows/*
!bin/windows/.gitkeep

# Python bytecode cache
__pycache__/

.sconsign*.dblite

# Ignore custom.py
custom.py

# Ignore generated compile_commands.json
compile_commands.json

# Ignore files generated for documentation
/src/gen

# Binaries
*.o
*.os
*.so
*.obj
*.bc
*.pyc
*.dblite
*.pdb
*.lib
*.config
*.creator
*.creator.user
*.files
*.includes
*.idb
*.exp

# Other stuff
*.log
*.lock

# VSCode
.vscode/*
!.vscode/extensions.json
.DS_Store

# Jetbrains
.idea/

# Cmake
cmake-build*
CMakeUserPresets.json

# CMake build output
/build/

# Gradle / Android build output
.gradle/
/project/android/build/

# Android export artifacts
*.apk
*.aab

# Godot export credentials (keystore paths/passwords — per machine, never commit)
project/export_credentials.cfg

# OpenCV (lokaler Build-Input, via Conan verwaltet — nicht eingecheckt)
opencv/

# Conan (von `scons`/`conan install` generiert)
conan_install/
SConscript_conandeps
conandeps*
conanbuild*
conanrun*
deactivate_conan*
conaninfo.txt
conan.lock
graph_info.json

# Godot hot-reload backup copies of loaded GDExtension DLLs (Windows)
~*.dll
