*.apk
*.aab

# Godot export credentials (keystore paths/passwords — per machine, never commit)
project/export_credentials.cfg

# OpenCV (lokaler Build-Input, via Conan verwaltet — nicht eingecheckt)
opencv/

# Conan (von `scons`/`conan install` generiert)
conan_install/
SConscript_conandeps
conandeps*
conanbuild*
conanrun*
deactivate_conan*
conaninfo.txt
conan.lock
graph_info.json

# Godot hot-reload backup copies of loaded GDExtension DLLs (Windows)
~*.dll
~*.TMP

# Godot editor scene/resource save temporaries (<file><random>.tmp, written next to the target and
# renamed over it). Orphaned when a save is interrupted or the rename is blocked.
*.tscn*.tmp
*.tres*.tmp
