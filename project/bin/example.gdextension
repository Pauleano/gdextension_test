[configuration]

entry_symbol = "snopek_tut_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
; godot-cpp baut den Dateinamen als: <name>.<platform>.<target>[.double].<arch><suffix>
; (".double" kommt VOR der Architektur). Linux/Android haben das "lib"-Praefix, Windows nicht.

windows.x86_64.single.debug = "./windows/snopek_tut.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/snopek_tut.windows.template_debug.double.x86_64.dll"
windows.x86_64.single.release = "./windows/snopek_tut.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/snopek_tut.windows.template_release.double.x86_64.dll"

macos.single.debug = "./macos/snopek_tut.macos.template_debug.framework"
macos.double.debug = "./macos/snopek_tut.macos.template_debug.framework"
macos.single.release = "./macos/snopek_tut.macos.template_release.framework"
macos.double.release = "./macos/snopek_tut.macos.template_release.framework"

linux.x86_64.single.debug = "./linux/libsnopek_tut.linux.template_debug.x86_64.so"
linux.x86_64.double.debug = "./linux/libsnopek_tut.linux.template_debug.double.x86_64.so"
linux.x86_64.single.release = "./linux/libsnopek_tut.linux.template_release.x86_64.so"
linux.x86_64.double.release = "./linux/libsnopek_tut.linux.template_release.double.x86_64.so"

; Android arm64 (Geraete). Weitere ABIs (arm32/x86_64/x86_32) nach demselben Muster.
android.arm64.single.debug = "./android/libsnopek_tut.android.template_debug.arm64.so"
android.arm64.double.debug = "./android/libsnopek_tut.android.template_debug.double.arm64.so"
android.arm64.single.release = "./android/libsnopek_tut.android.template_release.arm64.so"
android.arm64.double.release = "./android/libsnopek_tut.android.template_release.double.arm64.so"

; Android x86_64 (Emulator).
android.x86_64.single.debug = "./android/libsnopek_tut.android.template_debug.x86_64.so"
android.x86_64.double.debug = "./android/libsnopek_tut.android.template_debug.double.x86_64.so"
android.x86_64.single.release = "./android/libsnopek_tut.android.template_release.x86_64.so"
android.x86_64.double.release = "./android/libsnopek_tut.android.template_release.double.x86_64.so"
