[configuration]

entry_symbol = "snopek_tut_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.

windows.x86_64.single.debug = "./windows/snopek_tut.windows.template_debug.x86_64.dll"
windows.x86_64.double.debug = "./windows/snopek_tut.windows.template_debug.x86_64.double.dll"
windows.x86_64.single.release = "./windows/snopek_tut.windows.template_release.x86_64.dll"
windows.x86_64.double.release = "./windows/snopek_tut.windows.template_release.x86_64.double.dll"

